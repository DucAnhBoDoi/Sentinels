    - target: {fileID: 7000227155509413365, guid: a5cc1c8b543582042a872634b80a8451, type: 3}
      propertyPath: m_text
      value: 'The system is failing! Defend the <b>Core of Life</b> to spawn the
        <b>Fragments of Compassion</b>.



        <b><color=#FFD700>Combat:</color></b>
        Eliminate all incoming threats.

        <b><color=#FFA500>Charging:</color></b>
        Sacrifice your HP in the charging area to keep the Core alive.



        <i>Survive
        the countdown and press <b>[F]</b> to pick up items!</i>'
      objectReference: {fileID: 0}
